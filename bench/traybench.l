; traybench.l -- the tray ops rove leans on, timed end to end: `love bench/traybench.l N`
; prints ms per op over N reps of a 4096-element tray (the shapes of bench/loops.c), best of three rounds
(: n 4096
   reps (: a (argv) (? (two? >a) (read (<>a)) 200))
   xs (iota n + 0.0)
   ys (iota n * 0.5 + 1.0)
   zs (iota n)
   ws (iota n * 3 % 11)
   idx (iota n * 37 % (n + 8))
   (ms f) (: t0 (nclock 0) _ (: (go k) (? (k < 1) 0 (: _ (f 0) (go (k - 1)))) (go reps))
             (((((nclock 0) - t0) + 0.0) / reps) / 1000000.0))
   ; the best of three rounds: the collector's phase moves a mean by a third on the allocating rows
   (row nm f) (: t (min (ms f) (min (ms f) (ms f))) (puts (nm + " " + show t + "\n")))
   _ (row "fadd" (_ \ xs + ys))
   _ (row "fmul-scalar" (_ \ xs * 0.75))
   _ (row "poly" (_ \ ((xs * 0.5 + 1.0) * xs - 0.25) * xs + 2.0))
   _ (row "fmask" (_ \ xs < ys))
   _ (row "fmin" (_ \ min xs ys))
   _ (row "fsum" (_ \ net xs))
   _ (row "iadd" (_ \ zs + ws))
   _ (row "imax" (_ \ max zs ws))
   _ (row "gather" (_ \ peep xs idx -1.0))
   _ (row "floor" (_ \ floor ys))
   _ (row "sin" (_ \ sin xs))
   _ (row "bcast" (_ \ (iota 64 + 0.0) + (gem-tray [64 1] (map (x \ x + 0.0) ^64))))
   0)
