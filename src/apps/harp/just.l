; src/apps/harp/just.l -- just intonation as exact ratios, and the lattice they make.
; a pitch is a ratio (`3 /// 2`), exact until it turns into harp's 'note (semitones
; from middle c) at the edge, as qnum turns cycle time into frames.
;
; the lattice is a ratio's prime exponents past 2: a point [e3 e5 e7], so an interval
; is a vector -- a fifth one step along 3, a major third one along 5, a harmonic
; seventh one along 7 -- and octaves are the one direction it does not have. how far a
; ratio sits from home is its tenney height, log2 of num * den.

(module '(just
  jprimes jaxes jparts rinv pexp monzo unmonzo point unpoint oct near cents semis tenney lnorm
  jint jcomma jname edo-near cfrac convergents mos mos-steps vadd vsub vscale vdot pdiss)
(:
   jprimes [2 3 5 7]
   jaxes   [3 5 7]
   (jparts r) (coin? r ? (load r) [r 1])         ; (num den), den 1 for a whole one
   (ipow b e) (e < 1 ? 1 (b * ipow b (e - 1)))
   (rinv r)   (jparts r @ p (<>p /// <p))

   ; [rest k]: n with every factor p taken out, and how many there were
   (pexp n p) ((: (go m k) (m % p = 0 ? (go (m // p) (k + 1)) [m k])) n 0)

   ; the exponents over jprimes, or 'over for a ratio with a prime past 7
   (monzo r)
    (: (walk ps a b)
        (? !(two? ps) (a = 1 && b = 1 ? () 'over)
           (: x (pexp a <ps) y (pexp b <ps) rest (walk >ps <x <y)
              (rest = 'over ? 'over ((<>x - <>y) . rest))))
       p (jparts r)
       (walk jprimes <p <>p))
   (unmonzo m)
    (foldl (q \ pe \ (: p <pe e >pe
                        (e < 0 ? (q * (1 /// ipow p (0 - e))) (q * ipow p e))))
           1 (zip jprimes m))

   ; the lattice point, octave dropped; and back, in the octave above 1
   (point r)   (monzo r @ m (m = 'over ? 'over >m))
   (unpoint v) (oct (unmonzo (0 . v)))
   (oct r)     (? (r >= 2) (oct (r * (1 /// 2))) (r < 1) (oct (r * 2)) r)
   ; the octave nearest 1: within half an octave either side, so a center stays put
   (near r)    (oct r @ o (cents o > 600.0 ? (o * (1 /// 2)) o))

   (cents r)  (jparts r @ p (1200.0 * (log <p - log <>p) / log 2))
   (semis r)  (cents r / 100.0)
   (tenney r) (jparts r @ p ((log <p + log <>p) / log 2))
   ; how far a point is from home with octaves free: tenney height of its odd part,
   ; so a fifth up and a fifth down are the same distance
   (lnorm v) (foldl (+) 0.0 (map (p \ abs >p * log <p / log 2) (zip jaxes v)))

   jint {'unison 1 'minor-second (16 /// 15) 'major-second (9 /// 8)
         'minor-third (6 /// 5) 'major-third (5 /// 4) 'fourth (4 /// 3)
         'tritone (45 /// 32) 'fifth (3 /// 2) 'minor-sixth (8 /// 5)
         'major-sixth (5 /// 3) 'harmonic-seventh (7 /// 4) 'minor-seventh (9 /// 5)
         'major-seventh (15 /// 8) 'octave 2}
   ; the leftovers when two paths to one note disagree
   jcomma {'syntonic (81 /// 80) 'pythagorean (531441 /// 524288) 'diesis (128 /// 125)
           'septimal (64 /// 63) 'schisma (32805 /// 32768)}
   (jname r) (oct r @ o ((: (go ks) (? !(two? ks) () (jint <ks = o) <ks (go >ks)))
                         (sort (keys jint))))

   ; the nearest step of n equal divisions of the octave: [step error-in-cents]
   (edo-near n r) (: c (cents (oct r)) k (floor (n * c / 1200.0 + 0.5))
                     [k (c - k * 1200.0 / n)])

   ; continued fractions: k terms of x, and the fractions they converge through. the
   ; euclidean algorithm on log2 3/2 -- its denominators are the equal divisions whose
   ; fifths come closest: 12, 41, 53
   (cfrac x k) (k < 1 ? ()
                  (: a (floor x) f (x - a)
                     (a . (f < 0.000000001 ? () (cfrac (1.0 / f) (k - 1))))))
   (convergents as)
    (: (go as h1 k1 h0 k0) (two? as ?
                              (: h (<as * h1 + h0) k (<as * k1 + k0)
                                 ([h k] . go >as h k h1 k1)))
       (go as 1 0 0 1))

   ; a scale of n notes generated by stacking g and folding into one octave, and its
   ; steps told large (1) from small (0): for the fifth and seven, the diatonic
   ; pattern, which is a euclidean rhythm (harp's bjork) turned around
   (mos g n) (sort (map (i \ oct (ipow g i)) ^n))
   (mos-steps g n)
    (: s (mos g n)
       ds (map (p \ cents (>p * rinv <p)) (zip s (>s + [2])))
       lo (foldl min <ds ds)
       (map (d \ d > lo + 0.001 ? 1 0) ds))

   ; points as vectors
   (vadd u v)   (map (p \ <p + >p) (zip u v))
   (vsub u v)   (map (p \ <p - >p) (zip u v))
   (vscale s v) (map (x \ s * x) v)
   (vdot u v)   (foldl (+) 0 (map (p \ <p * >p) (zip u v)))

   ; how rough a phrase is: the mean tenney height over each pair of its notes
   (pdiss rs)
    (: (pairs l) (two? l ? (map (y \ [<l y]) >l + pairs >l))
       ps (pairs rs)
       (? !(two? ps) 0.0
          (foldl (+) 0.0 (map (q \ tenney (oct (q 1 * rinv (q 0)))) ps) / #ps))))
) ; module just
