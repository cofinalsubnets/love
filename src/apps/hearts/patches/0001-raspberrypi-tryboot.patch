firmware: raspberrypi: a restart's " tryboot" sets the firmware's one-shot reboot flag

mainline passes the reboot argument to no one, so `reboot "0 tryboot"` cannot start an
A/B trial on a Pi. Raspberry Pi's kernel sets RPI_FIRMWARE_SET_REBOOT_FLAGS from a reboot
notifier; this does the same with the notifier in struct rpi_firmware, not a global.

--- a/drivers/firmware/raspberrypi.c
+++ b/drivers/firmware/raspberrypi.c
@@ -14,7 +14,9 @@
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/reboot.h>
 #include <linux/slab.h>
+#include <linux/string.h>
 #include <soc/bcm2835/raspberrypi-firmware.h>
 
 #define MBOX_MSG(chan, data28)		(((data28) & ~0xf) | ((chan) & 0xf))
@@ -32,6 +34,7 @@
 	u32 enabled;
 
 	struct kref consumers;
+	struct notifier_block reboot;
 };
 
 static DEFINE_MUTEX(transaction_lock);
@@ -273,6 +276,23 @@
 	rpi_firmware_put(fw);
 }
 
+/*
+ * A restart's argument is the partition to boot and then flags. " tryboot" sets the
+ * firmware's one-shot flag: the next boot reads tryboot.txt, or the [tryboot] section of
+ * autoboot.txt, so an A/B update can be tried once and fall back by itself.
+ */
+static int rpi_firmware_notify_reboot(struct notifier_block *nb,
+				      unsigned long action, void *data)
+{
+	struct rpi_firmware *fw = container_of(nb, struct rpi_firmware, reboot);
+	u32 flags = 1;
+
+	if (action == SYS_RESTART && data && strstr(data, " tryboot"))
+		rpi_firmware_property(fw, RPI_FIRMWARE_SET_REBOOT_FLAGS,
+				      &flags, sizeof(flags));
+	return NOTIFY_DONE;
+}
+
 static int rpi_firmware_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -302,6 +322,9 @@
 
 	platform_set_drvdata(pdev, fw);
 
+	fw->reboot.notifier_call = rpi_firmware_notify_reboot;
+	register_reboot_notifier(&fw->reboot);
+
 	rpi_firmware_print_firmware_revision(fw);
 	rpi_register_hwmon_driver(dev, fw);
 	rpi_register_clk_driver(dev);
@@ -323,6 +346,7 @@
 {
 	struct rpi_firmware *fw = platform_get_drvdata(pdev);
 
+	unregister_reboot_notifier(&fw->reboot);
 	platform_device_unregister(rpi_hwmon);
 	rpi_hwmon = NULL;
 	platform_device_unregister(rpi_clk);
--- a/include/soc/bcm2835/raspberrypi-firmware.h
+++ b/include/soc/bcm2835/raspberrypi-firmware.h
@@ -91,6 +91,8 @@
 	RPI_FIRMWARE_GET_POE_HAT_VAL =                        0x00030049,
 	RPI_FIRMWARE_SET_POE_HAT_VAL =                        0x00030050,
 	RPI_FIRMWARE_NOTIFY_XHCI_RESET =                      0x00030058,
+	RPI_FIRMWARE_GET_REBOOT_FLAGS =                       0x00030064,
+	RPI_FIRMWARE_SET_REBOOT_FLAGS =                       0x00038064,
 	RPI_FIRMWARE_NOTIFY_DISPLAY_DONE =                    0x00030066,
 
 	/* Dispmanx TAGS */
