; src/apps/hearts/oidreg.l -- the kernel's lib/build_OID_registry, ported: oid_registry.h's OID_
; enum, each with its dotted OID in a comment, to oid_registry_data.c -- the index, the base-128
; encodings, and the search table by hash then length then content. pinned by the script's sha256,
; and held byte-identical to perl's output (the encoded length rides perl's own float log, as the
; script computes it).
; usage: love oidreg.l SCRIPT IN-H OUT-C   ($srctree, from kbuild, trims the script's name)
(: argv cmdline
   pinned "3314c9aaead629ffd8a022dae27218a5e4d63c0ef25bc648be2da3c844edce7a"
   (die m) (puts ("oidreg: " + m + "\n"), quit 1)
   script (argv 2)
   _ (uread script @ [1 s] (sha256 s = pinned || (die (script + " is not the pinned build_OID_registry"))) (die ("cannot read " + script)))
   hdr (uread (argv 3) @ [1 s] s (die ("cannot read " + argv 3)))
   (lastof l) (atom? >l ? <l (lastof >l))
   (sp? c) (c = 32 || 9 <= c <= 13)
   (dg? c) (48 <= c <= 57)
   (wd? c) (c = 95 || dg? c || 65 <= c <= 90 || 97 <= c <= 122)
   ; m!\s+OID_([a-zA-z][a-zA-Z0-9_]+),\s+/[*]\s+([012][.0-9]*)\s+[*]/! at OID_ found at k
   (spn l i f) (i < #l && f (l i) ? (spn l (i + 1) f) i)
   (at l k)
    (: n #l
       (? !(0 < k && sp? (l (k - 1)) && 65 <= l (k + 4) <= 122) ()
          (: e (spn l (k + 5) wd?)
             w (spn l (e + 1) sp?)
             (? (e < k + 6 || e >= n || l e != 44 || w = e + 1 || snip l w (w + 2) != "/*") ()
                (: d (spn l (w + 2) sp?)
                   de (spn l (d + 1) (c \ dg? c || c = 46))
                   z (spn l de sp?)
                   (? (d = w + 2 || d >= n || !(48 <= l d <= 50) || z = de || snip l z (z + 2) != "*/") ()
                      [(snip l (k + 4) e) (snip l d de)]))))))
   (next l k) (k + 1 >= #l ? -1 (findsub (snip l (k + 1) #l) "OID_" @ j (j < 0 ? -1 (k + 1 + j))))
   (scan l k) (? (k < 0) () (at l k @ r (two? r ? r (scan l (next l k)))))
   ents (filter two? (map (l \ scan l (findsub l "OID_")) (lines hdr)))
   names (map (e \ e 0) ents)
   oids (map (e \ e 1) ents)
   (comps o) (map read (words (string (map (c \ c = 46 ? 32 c) (chars o)))))
   ; perl's int(log(c)/log(2)), then /7: the base-128 digits past the first
   (extra c) (c = 0 ? 0 (int (int (log c / log 2) / 7)))
   lens (map (o \ comps o @ cs (#cs - 1 + net (map extra (>>cs)))) oids)
   idx ((: (go l t acc) (atom? l ? (rev acc) (go >l (t + <l) (t . acc)))) lens 0 ())
   total (net lens)
   (enc o) (comps o @ cs
             ((<cs * 40 + <>cs) . catmap (c \ (extra c @ k ((map (j \ (((c >> ((k - j) * 7)) & 127) | 128)) ^k) + [(c & 127)]))) >>cs))
   encs (map enc oids)
   hashes (map (os \ (: h (#os - 1 + net (map (o \ o * 33) os))
                       (((h >> 24) ^ (h >> 16) ^ (h >> 8) ^ h) & 255))) encs)
   nn #names
   order (map lastof (sort (map (i \ [(hashes i) #(encs i)] + rev (encs i) + [i]) ^nn)))
   (pad w s) (#s >= w ? s (pad w (" " + s)))
   (padr w s) (#s >= w ? s (padr w (s + " ")))
   (hx2 v) (string [("0123456789abcdef" (v >> 4)) ("0123456789abcdef" (v & 15))])
   ; the script's own name as it printed it: $0 less the source tree's prefix
   st (getenv "srctree" || "")
   sname ((0 < #st && #script > #st && snip script 0 (#st + 1) = st + "/") ? (snip script (#st + 1) #script) script)
   text (join "" [
     "/*\n * Automatically generated by " sname ".  Do not edit\n */\n\n"
     (total <= 255 ? "static const unsigned char oid_index[OID__NR + 1] = {\n" "static const unsigned short oid_index[OID__NR + 1] = {\n")
     (join "" (map (i \ "\t[OID_" + names i + "] = " + show (idx i) + ",\n") ^nn))
     ("\t[OID__NR] = " + show total + "\n};\n")
     ("\nstatic const unsigned char oid_data[" + show total + "] = {\n")
     (join "" (map (i \ "\t" + join "" (map (o \ show o + ", ") (encs i)) + "\t// " + names i + "\n") ^nn))
     "};\n"
     "\nstatic const struct {\n\tunsigned char hash;\n"
     (nn - 1 <= 255 ? "\tenum OID oid : 8;\n" "\tenum OID oid : 16;\n")
     "} oid_search_table[OID__NR] = {\n"
     (join "" (map (i \ order i @ k ("\t[" + pad 3 (show i) + "] = { " + pad 3 (show (hashes k)) + ", OID_" + padr 35 (names k)
                                       + " }, // " + join "" (map hx2 (encs k)) + "\n")) ^nn))
     "};\n"])
   (uwrite (argv 4) text))
