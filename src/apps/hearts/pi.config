# hearts on the raspberry pi: arm64 defconfig with the pi drivers built in, one Image for the
# zero 2 w (bcm2837) and the pi 4 (bcm2711), the dtb and config.txt all that differ; no modules
# wifi: brcmfmac's sdio chips, and the reset line wifi-pwrseq waits on
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_RESET_GPIO=y
# usb otg serial: a configfs acm gadget on dwc2
CONFIG_USB_CONFIGFS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
# display: vc4's hdmi and vec, and v3d; vc4 rides on sound for hdmi audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_CEC_CORE=y
# the soc: cpufreq, thermal, hwmon, i2c, spi, pwm
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
CONFIG_BCM2835_THERMAL=y
CONFIG_BCM2711_THERMAL=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_BCM2835AUX=y
CONFIG_PWM_BCM2835=y
# pi 4: genet and its phy, and pcie for the vl805 usb
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_PCIE_BRCMSTB=y
# iwd: the af_alg user api, keyctl's dh, and the algorithms it checks at start
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_CMAC=y
# the radio's firmware and cfg80211's rules inside the Image, from $HEARTS_FW: both ask before
# the root is mounted. no clm_blob: the pi ships none for the 43436s
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s brcm/brcmfmac43430b0-sdio.raspberrypi,model-zero-2-w.bin brcm/brcmfmac43430b0-sdio.raspberrypi,model-zero-2-w.txt brcm/brcmfmac43430b0-sdio.raspberrypi,model-zero-2-w.clm_blob brcm/brcmfmac43430-sdio.raspberrypi,model-zero-2-w.bin brcm/brcmfmac43430-sdio.raspberrypi,model-zero-2-w.txt brcm/brcmfmac43436s-sdio.raspberrypi,model-zero-2-w.bin brcm/brcmfmac43436s-sdio.raspberrypi,model-zero-2-w.txt brcm/brcmfmac43436-sdio.raspberrypi,model-zero-2-w.bin brcm/brcmfmac43436-sdio.raspberrypi,model-zero-2-w.txt brcm/brcmfmac43436-sdio.raspberrypi,model-zero-2-w.clm_blob"
