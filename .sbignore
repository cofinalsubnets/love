# svalbard's ignore list, one rule a line, read by sb's walk and by the dist cut
# (u/selfpack.l). a rule holding * ? [ is a glob over the whole relative path
# and `*` crosses `/`; every other rule is a path prefix at a segment boundary.
# the built-ins .sb .git b need no line here. those three are directories and are asked
# only of a directory, so a file by one of those names is a file (gitignore's `/b/`).

# downloaded, never built
dl

# the engineering narratives, and the design record: local, and gitignored besides.
# named here too so the dist cut agrees with git rather than relying on it.
notes

# rocq/lean build products. these sit UNDER t/proof, which the archive keeps
# for its 14 tracked sources -- so they are globs, not a prefix.
*.vo
*.vok
*.vos
*.glob
*.cache
t/proof/rocq/.*.aux
t/proof/lean/*.olean

# generated proof terms: their gates lay them from the corpus on every run
t/proof/rocq/gen.v
t/proof/rocq/uugen.v
t/proof/lean/uugen.lean

# the project's web page and what it alone links: generated, committed for github
# pages, never shipped (the machine's pair is `make site-wasm`'s copy out of b/)
index.html
w/style.css
w/favicon.png
w/fonts
w/wasm/love-wasm.wasm
w/wasm/love-wasm.image

# editor and debugger leavings
vgcore.*
.gdb_history
