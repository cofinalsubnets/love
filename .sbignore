# svalbard's ignore list, one rule a line, read by sb's walk and by the dist cut
# (tools/selfpack.l). a rule holding * ? [ is a glob over the whole relative path
# and `*` crosses `/`; every other rule is a path prefix at a segment boundary.
# the built-ins .sb .git out need no line here.

# downloaded, never built
dl

# the engineering narratives, and the design record: read locally, never shipped
doc/archive

# rocq/lean build products. these sit UNDER test/proof, which the archive keeps
# for its 14 tracked sources -- so they are globs, not a prefix.
*.vo
*.vok
*.vos
*.glob
*.cache
test/proof/rocq/.*.aux
test/proof/lean/*.olean

# generated proof terms: their gates lay them from the corpus on every run
test/proof/rocq/gen.v
test/proof/rocq/uugen.v
test/proof/lean/uugen.lean

# the project's web page and what it alone links: generated, committed for github
# pages, never shipped (the module is `make wasm`'s, copied beside its loader)
index.html
assets
src/port/wasm/love.wasm
src/port/wasm/love.image

# editor and debugger leavings
vgcore.*
.gdb_history
