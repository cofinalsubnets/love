# svalbard's ignore list, one rule a line, read by sb's walk and by the dist cut
# (tools/selfpack.l). a rule holding * ? [ is a glob over the whole relative path
# and `*` crosses `/`; every other rule is a path prefix at a segment boundary.
# the built-ins .sb .git out need no line here. those three are directories and are asked
# only of a directory, so a file by one of those names is a file (gitignore's `/out/`).

# downloaded, never built
dl

# the engineering narratives, and the design record: local, and gitignored besides.
# named here too so the dist cut agrees with git rather than relying on it.
notes

# rocq/lean build products. these sit UNDER test/proof, which the archive keeps
# for its 14 tracked sources -- so they are globs, not a prefix.
*.vo
*.vok
*.vos
*.glob
*.cache
test/proof/rocq/.*.aux
test/proof/lean/*.olean

# generated proof terms: their gates lay them from the corpus on every run
test/proof/rocq/gen.v
test/proof/rocq/uugen.v
test/proof/lean/uugen.lean

# what the project's web page alone links: generated, committed for github pages,
# never shipped (the machine's pair is `make site-wasm`'s copy out of out/). the page,
# index.html, and its stylesheet, web/style.css, are written by hand and ship with the source
web/favicon.png
web/wasm/love.wasm
web/wasm/love.image

# editor and debugger leavings
vgcore.*
.gdb_history
