; apps/tfm.l -- TeX font metrics: the TFM file, read. `(borrow 'tfm)`:
;
;   (tfm-pl s)     -> (pl msgs)   the property list tftopl writes for the bytes s, and what
;                                 it says on the terminal; pl is "" when it gives up
;   (tfm-read s sz) -> font | 'badtfm  the font as TeX loads it, every dimension scaled to
;                                 sz (-1000 the design size, >= 0 an at size in sp, < 0 a
;                                 scale of -sz/1000), refused where TeX refuses it
;   (xn-over-d x n d) -> x*n/d as TeX rounds it
;   (tfm-sizes s)  -> sizes | why  the twelve sizes and the subfiles' base addresses, or
;                                 tftopl's reason for refusing the file
;
; a TFM is a font's metrics and nothing of its shapes: twelve 16-bit sizes (lf lh bc ec nw
; nh nd ni nl nk ne np), a header (checksum, design size, coding scheme, family, face),
; four bytes of char_info per character indexing the width, height, depth and italic
; tables, then the lig/kern program, the kerns, the extensible recipes and the font's
; parameters. a dimension is a fix_word: four bytes, signed, twenty bits of fraction.
;
; tfm-pl is Knuth's TFtoPL, section for section, so that its answers can be held to
; tftopl's byte for byte. it corrects a bad file as tftopl does -- in place, on its own
; copy of the bytes -- and says so.
(module (tfm tfm-pl tfm-sizes tfm-read xn-over-d)
(:
   ; --- the output: a jug, a nesting level, and the lines tftopl would print --------
   (st-new s)
    (: n #s t (cask (n + 4)) _ (pour t 0 s 0 n)
       {'t t 'o (jug 0) 'm (jug 0) 'lv 0 'perfect 1 'ft 0 'bchar 256 'blabel 32767})
   (b st k) (peep (st 't) k 0)
   (bset st k v) (pin (st 't) k v)
   (out st s) (say (st 'o) s)
   (msg st s) (say (st 'm) s)
   (out-ln st) (: _ (out st "\n") (go l) (? (0 < l) (: _ (out st "   ") (go (l - 1))))
                  (go (st 'lv)))
   (left st) (: _ (pin st 'lv (st 'lv + 1)) (out st "("))
   (right st) (: _ (pin st 'lv (st 'lv - 1)) _ (out st ")") (out-ln st))
   ; tftopl's progress list of character codes is not printed, so no line is ever open
   (bad st m) (: _ (pin st 'perfect 0) (msg st ("Bad TFM file: " + m + "\n")))
   (octal c) ("'" + (string (48 + c // 64 % 8)) + (string (48 + c // 8 % 8)) + string (48 + c % 8))

   ; --- values ---------------------------------------------------------------------
   (out-bcpl st k)
    (: _ (out st " ")
       (go j l) (? (0 < l)
                   (: c (b st j) d (c // 32)
                      _ (? (0 < d && d < 4) (out st (? (c = 127) " " (string c))))
                      (go (j + 1) (l - 1))))
       (go (k + 1) (b st k)))
   ; l bytes at k, as tftopl's accumulator reads them: three bits a digit, low first
   (out-octal st k l)
    (: (red l a bb ds)
        (? (l < 1) [a ds]
           (: l2 (l - 1) v (b st (k + l2))
              (? (v = 0) (red l2 a (bb + 8) ds)
                 (: (drain a bb ds) (? (bb > 2) (drain (a // 8) (bb - 3) (a % 8 . ds)) [a bb ds])
                    r (drain a bb ds) a2 <r bb2 <>r ds2 <>>r
                    (red l2 (? (bb2 = 0) v (bb2 = 1) (a2 + 2 * v) (a2 + 4 * v)) (bb2 + 8) ds2)))))
       r (red l 0 0 ())
       (fin a ds) (? (0 < a || !(two? ds)) (fin (a // 8) (a % 8 . ds)) ds)
       ds (fin <r <>r)
       (out st (" O " + cats (map (d \ string (48 + d)) ds))))
   (out-char st c)
    (? (0 < st 'ft) (: _ (bset st 0 c) (out-octal st 0 1))
       (48 <= c <= 57 || 65 <= c <= 90 || 97 <= c <= 122) (out st (" C " + string c))
       (: _ (bset st 0 c) (out-octal st 0 1)))
   (out-face st k)
    (: v (b st k)
       (? (18 <= v) (out-octal st k 1)
          (: s (v % 2) bb (v // 2)
             (out st (" F " + string ("MBL" (bb % 3)) + string ("RI " s) + string ("RCE" (bb // 3)))))))
   ; enough decimal places for PLtoTF to recover every bit
   (out-fix st k)
    (: _ (out st " R ")
       a0 (b st k * 16 + b st (k + 1) // 16)
       f0 ((b st (k + 1) % 16 * 256 + b st (k + 2)) * 256 + b st (k + 3))
       neg (a0 > 2047)
       a (? !neg a0 (0 < f0) (4096 - a0 - 1) (4096 - a0))
       f (? (neg && 0 < f0) (1048576 - f0) f0)
       _ (? neg (out st "-"))
       _ (out st (show a))
       _ (out st ".")
       (go f dl) (: f2 (? (dl > 1048576) (f + 524288 - dl // 2) f)
                    _ (out st (show (f2 // 1048576)))
                    fn (10 * (f2 % 1048576)) dn (dl * 10)
                    (? (fn <= dn) () (go fn dn)))
       (go (10 * f + 5) 10))

   ; --- the header ------------------------------------------------------------------
   (check-bcpl st k l)
    (: _ (? (l <= b st k) (: _ (bad st "String is too long; I've shortened it drastically.") (bset st k 1)))
       (go j) (? (j <= k + b st k)
                 (: c (b st j)
                    _ (? (c = 40 || c = 41)
                         (: _ (bad st "Parenthesis in string has been changed to slash.") (bset st j 47))
                         (c < 32 || c > 126)
                         (: _ (bad st "Nonstandard ASCII code has been blotted out.") (bset st j 63))
                         (97 <= c <= 122) (bset st j (c - 32)))
                    (go (j + 1))))
       (go (k + 1)))
   (do-header st h)
    (: lh (h 'lh) cs 24 ds 28 sc 32 fam 72 rw 92
       _ (? (12 <= lh)
            (: _ (check-bcpl st sc 40)
               _ (? (11 <= b st sc && snip (string (st 't)) (sc + 1) (sc + 12) = "TEX MATH SY") (pin st 'ft 1)
                    (11 <= b st sc && snip (string (st 't)) (sc + 1) (sc + 12) = "TEX MATH EX") (pin st 'ft 2))
               _ (? (17 <= lh)
                    (: _ (left st) _ (out st "FAMILY") _ (check-bcpl st fam 20) _ (out-bcpl st fam) _ (right st)
                       (? (18 <= lh)
                          (: _ (left st) _ (out st "FACE") _ (out-face st (rw + 3)) _ (right st)
                             (go i) (? (i < lh) (: _ (left st) _ (out st ("HEADER D " + show i))
                                                   _ (out-octal st (cs + 4 * i) 4) _ (right st) (go (i + 1))))
                             (go 18)))))
               _ (left st) _ (out st "CODINGSCHEME") _ (out-bcpl st sc) (right st)))
       _ (left st) _ (out st "DESIGNSIZE")
       _ (? (127 < b st ds) (: _ (bad st "Design size negative!") _ (msg st "I've set it to 10 points.\n") (out st " D 10"))
            (b st ds = 0 && b st (ds + 1) < 16)
             (: _ (bad st "Design size too small!") _ (msg st "I've set it to 10 points.\n") (out st " D 10"))
            (out-fix st ds))
       _ (right st)
       _ (out st "(COMMENT DESIGNSIZE IS IN POINTS)") _ (out-ln st)
       _ (out st "(COMMENT OTHER SIZES ARE MULTIPLES OF DESIGNSIZE)") _ (out-ln st)
       _ (left st) _ (out st "CHECKSUM") _ (out-octal st cs 4) _ (right st)
       (? (lh > 17 && 127 < b st rw) (: _ (left st) _ (out st "SEVENBITSAFEFLAG TRUE") (right st))))

   ; --- the parameters and the fix_word checks ----------------------------------------
   (check-fix st k what i)
    (? (0 < b st k && b st k < 255)
       (: _ (bset st k 0) _ (bset st (k + 1) 0) _ (bset st (k + 2) 0) _ (bset st (k + 3) 0)
          _ (bad st (what + " " + show i + " is too big;"))
          (msg st "I have set it to zero.\n")))
   (pname ft i)
    (? (i <= 7) (["" "" "SPACE" "STRETCH" "SHRINK" "XHEIGHT" "QUAD" "EXTRASPACE"] i)
       (i <= 22 && ft = 1)
        (["NUM1" "NUM2" "NUM3" "DENOM1" "DENOM2" "SUP1" "SUP2" "SUP3" "SUB1" "SUB2"
          "SUPDROP" "SUBDROP" "DELIM1" "DELIM2" "AXISHEIGHT"] (i - 8))
       (i <= 13 && ft = 2) (? (i = 8) "DEFAULTRULETHICKNESS" ("BIGOPSPACING" + show (i - 8)))
       ("PARAMETER D " + show i))
   (do-params st h)
    (: np (h 'np) pb (h 'param)
       _ (? (0 < np)
            (: _ (left st) _ (out st "FONTDIMEN") _ (out-ln st)
               (go i) (? (i <= np)
                         (: k (4 * (pb + i))
                            _ (left st)
                            _ (? (i = 1) (out st "SLANT")
                                 (: _ (check-fix st k "Parameter" i) (out st (pname (st 'ft) i))))
                            _ (out-fix st k) _ (right st)
                            (go (i + 1))))
               _ (go 1)
               (right st)))
       (? (st 'ft = 1 && np != 22)
          (msg st ("Unusual number of fontdimen parameters for a math symbols font (" + show np + " not 22).\n"))
          (st 'ft = 2 && np != 13)
          (msg st ("Unusual number of fontdimen parameters for an extension font (" + show np + " not 13).\n"))))
   (nonzero st k) (0 < b st k || 0 < b st (k + 1) || 0 < b st (k + 2) || 0 < b st (k + 3))
   (check-fixes st h)
    (: _ (? (nonzero st (4 * h 'width)) (bad st "width[0] should be zero."))
       _ (? (nonzero st (4 * h 'height)) (bad st "height[0] should be zero."))
       _ (? (nonzero st (4 * h 'depth)) (bad st "depth[0] should be zero."))
       _ (? (nonzero st (4 * h 'italic)) (bad st "italic[0] should be zero."))
       (each base n what) (: (go i) (? (i < n) (: _ (check-fix st (4 * (base + i)) what i) (go (i + 1)))) (go 0))
       _ (each (h 'width) (h 'nw) "Width")
       _ (each (h 'height) (h 'nh) "Height")
       _ (each (h 'depth) (h 'nd) "Depth")
       _ (each (h 'italic) (h 'ni) "Italic correction")
       (each (h 'kern) (h 'nk) "Kern"))

   ; --- char_info --------------------------------------------------------------------
   (ci h c) (4 * (h 'char + c))
   (widx st h c) (b st (ci h c))
   (hidx st h c) (b st (ci h c + 1) // 16)
   (didx st h c) (b st (ci h c + 1) % 16)
   (iidx st h c) (b st (ci h c + 2) // 4)
   (tag st h c) (b st (ci h c + 2) % 4)
   (rem st h c) (b st (ci h c + 3))
   (reset-tag st h c) (bset st (ci h c + 2) (4 * iidx st h c))
   (none? st h c) (c < h 'bc || c > h 'ec || widx st h c = 0)
   (lstep h i) (4 * (h 'lig + i))
   (bad-char st m c) (bad st (m + " nonexistent character " + octal c + "."))
   (range-error st what c)
    (: _ (pin st 'perfect 0)
       (msg st (" \n" + what + " index for character " + octal c + " is too large;\nso I reset it to zero.\n")))

   ; --- the lig/kern program -----------------------------------------------------------
   ; activity: 0 unreachable, 1 passed through, 2 accessible
   (act st i) (peep (st 'act) i 0)
   (act! st i v) (pin (st 'act) i v)
   ; the labels, sorted by address; equal addresses keep their order of arrival
   (label-in st c r)
    (: (ins l) (? (!(two? l) || r < <>(<l)) ([c r] . l) (<l . ins >l))
       (pin st 'labels (ins (st 'labels))))
   (lig-prep st h)
    (: nl (h 'nl)
       _ (? (0 < nl)
            (: _ (? (b st (lstep h 0) = 255)
                    (: _ (left st) _ (out st "BOUNDARYCHAR")
                       _ (pin st 'bchar (b st (lstep h 0 + 1)))
                       _ (out-char st (st 'bchar)) _ (right st)
                       (act! st 0 1)))
               k (lstep h (nl - 1))
               (? (b st k = 255)
                  (: r (256 * b st (k + 2) + b st (k + 3))
                     _ (? (nl <= r)
                          (: _ (pin st 'perfect 0)
                             (msg st " \nLigature/kern starting index for boundarychar is too large;so I removed it.\n"))
                          (: _ (pin st 'labels [[256 r]]) _ (pin st 'blabel r) (act! st r 2)))
                     (act! st (nl - 1) 1)))))
       (go c) (? (c <= h 'ec)
                 (: _ (? (tag st h c = 1)
                         (: r0 (rem st h c)
                            r (? (r0 < nl && 128 < b st (lstep h r0))
                                 (: r1 (256 * b st (lstep h r0 + 2) + b st (lstep h r0 + 3))
                                    _ (? (r1 < nl && act st r0 = 0) (act! st r0 1))
                                    r1)
                                 r0)
                            (? (nl <= r)
                               (: _ (pin st 'perfect 0)
                                  _ (msg st (" \nLigature/kern starting index for character " + octal c
                                             + " is too large;\nso I removed it.\n"))
                                  (reset-tag st h c))
                               (: _ (label-in st c r) (act! st r 2)))))
                    (go (c + 1))))
       (go (h 'bc)))
   (lig-activity st h)
    (: nl (h 'nl)
       (go i) (? (i < nl)
                 (: _ (? (act st i = 2)
                         (: r (b st (lstep h i))
                            (? (r < 128)
                               (: r2 (r + i + 1)
                                  (? (nl <= r2)
                                     (: _ (bad st ("Ligature/kern step " + show i + " skips too far;"))
                                        _ (msg st "I made it stop.\n")
                                        (bset st (lstep h i) 128))
                                     (act! st r2 2))))))
                    (go (i + 1))))
       (go 0))
   ; one step of the program at i; answers its first byte's address
   (out-step st h i)
    (: k (lstep h i) nl (h 'nl)
       _ (? (128 < b st k)
            (? (nl <= 256 * b st (k + 2) + b st (k + 3))
               (bad st "Ligature unconditional stop command address is too big."))
            (128 <= b st (k + 2))
             (: _ (? (none? st h (b st (k + 1)) && b st (k + 1) != st 'bchar)
                     (: _ (bad-char st "Kern step for" (b st (k + 1))) (bset st (k + 1) (h 'bc))))
                _ (left st) _ (out st "KRN") _ (out-char st (b st (k + 1)))
                r (256 * (b st (k + 2) - 128) + b st (k + 3))
                _ (? (h 'nk <= r) (: _ (bad st "Kern index too large.") (out st " R 0.0"))
                     (out-fix st (4 * (h 'kern + r))))
                (right st))
            (: _ (? (none? st h (b st (k + 1)) && b st (k + 1) != st 'bchar)
                    (: _ (bad-char st "Ligature step for" (b st (k + 1))) (bset st (k + 1) (h 'bc))))
               _ (? (none? st h (b st (k + 3)))
                    (: _ (bad-char st "Ligature step produces the" (b st (k + 3))) (bset st (k + 3) (h 'bc))))
               _ (left st)
               r0 (b st (k + 2))
               r (? (r0 = 4 || (r0 > 7 && r0 != 11))
                    (: _ (msg st "Ligature step with nonstandard code changed to LIG\n") _ (bset st (k + 2) 0) 0)
                    r0)
               _ (? (r % 4 > 1) (out st "/"))
               _ (out st "LIG")
               _ (? (r % 2 = 1) (out st "/"))
               (arrows r) (? (r > 3) (: _ (out st ">") (arrows (r - 4))))
               _ (arrows r)
               _ (out-char st (b st (k + 1))) _ (out-char st (b st (k + 3)))
               (right st)))
       _ (? (0 < b st k && st 'lv = 1)
            (: _ (? (128 <= b st k) (out st "(STOP)")
                    (: (cnt ai n) (? (i + b st k < ai) n (cnt (ai + 1) (? (act st ai = 2) (n + 1) n)))
                       (out st ("(SKIP D " + show (cnt (i + 1) 0) + ")"))))
               (out-ln st)))
       k)
   (lig-out st h)
    (: nl (h 'nl)
       (go acti ls)
        (? (acti < nl)
           (? (act st acti = 1) (go (acti + 1) ls)
              (: _ (? (act st acti = 0)
                      (? (st 'lv = 1) (: _ (left st) _ (out st "COMMENT THIS PART OF THE PROGRAM IS NEVER USED!") (out-ln st)))
                      (st 'lv = 2) (right st))
                 (labs ls) (? (two? ls && <>(<ls) = acti)
                              (: _ (left st) _ (out st "LABEL")
                                 _ (? (<(<ls) = 256) (out st " BOUNDARYCHAR") (out-char st <(<ls)))
                                 _ (right st)
                                 (labs >ls))
                              ls)
                 ls2 (labs ls)
                 _ (out-step st h acti)
                 (go (acti + 1) ls2)))
           (? (st 'lv = 2) (right st)))
       (go 0 (st 'labels)))

   ; --- ligature cycles: tftopl's ordered hash, f(x,y) by depth-first evaluation -------
   (cycles st h)
    (: hs 5003 hk {} cls {} lz {} n {'n 0 'x 256 'y 256 'l ()}
       (hget i) (peep hk i 0)
       (hset i v) (pin hk i v)
       (input c i)
        (: k (lstep h i) y (b st (k + 1)) t (b st (k + 2))
           cz (? (128 <= t) [0 y]
                 (t = 0 || t = 6) [0 (b st (k + 3))]
                 (t = 5 || t = 11) [0 y]
                 (t = 1 || t = 7) [1 (b st (k + 3))]
                 (t = 2) [2 (b st (k + 3))]
                 [3 (b st (k + 3))])
           (ins hh key cc zz)
            (? (0 < hget hh)
               (? (hget hh <= key)
                  (? (hget hh = key) ()
                     (: ok (hget hh) oc (peep cls hh 0) oz (peep lz hh 0)
                        _ (hset hh key) _ (pin cls hh cc) _ (pin lz hh zz)
                        (ins (? (0 < hh) (hh - 1) hs) ok oc oz)))
                  (ins (? (0 < hh) (hh - 1) hs) key cc zz))
               (: _ (hset hh key) _ (pin cls hh cc) _ (pin lz hh zz)
                  _ (pin n 'n (n 'n + 1))
                  (pin n 'l (hh . n 'l))))
           key (256 * c + y + 1)
           (? (n 'n = hs) () (ins (1009 * key % hs) key <cz <>cz)))
       (enter c i) (: _ (input c i) k (b st (lstep h i))
                      j (? (128 <= k) (h 'nl) (i + 1 + k))
                      (? (j < h 'nl) (enter c j)))
       _ (: (go c) (? (c <= h 'ec)
                      (: _ (? (tag st h c = 1)
                              (: i0 (rem st h c)
                                 i (? (128 < b st (lstep h i0)) (256 * b st (lstep h i0 + 2) + b st (lstep h i0 + 3)) i0)
                                 (enter c i)))
                         (go (c + 1))))
            (go (h 'bc)))
       _ (? (st 'blabel < h 'nl) (enter 256 (st 'blabel)))
       ; f and eval, mutually recursive
       (ev x y) (: key (256 * x + y + 1)
                   (seek hh) (? (hget hh > key) (seek (? (0 < hh) (hh - 1) hs)) hh)
                   hh (seek (1009 * key % hs))
                   (? (hget hh < key) y (f hh x y)))
       (f hh x y)
        (: c (peep cls hh 0)
           _ (? (c = 1) (: _ (pin cls hh 4) _ (pin lz hh (ev (peep lz hh 0) y)) (pin cls hh 0))
                (c = 2) (: _ (pin cls hh 4) _ (pin lz hh (ev x (peep lz hh 0))) (pin cls hh 0))
                (c = 3) (: _ (pin cls hh 4) _ (pin lz hh (ev (ev x (peep lz hh 0)) y)) (pin cls hh 0))
                (c = 4) (: _ (pin n 'x x) _ (pin n 'y y) _ (pin lz hh 257) (pin cls hh 0)))
           (peep lz hh 0))
       hl (rev (n 'l))
       _ (? (n 'n = hs) (pin st 'fatal "Sorry, I haven't room for so many ligature/kern pairs!\n"))
       _ (map (hh \ (? (0 < peep cls hh 0) (f hh ((hget hh - 1) // 256) ((hget hh - 1) % 256))))
              hl)
       (? (n 'y < 256)
          (: _ (msg st ("Infinite ligature loop starting with "
                        + (? (n 'x = 256) "boundary" (octal (n 'x))) + " and " + octal (n 'y) + "!\n"))
             _ (out st "(INFINITE LIGATURE LOOP MUST BE BROKEN!)")
             (pin st 'fatal 1))))
   (do-ligs st h)
    (: _ (pin st 'act (cask (h 'nl + 1)))
       _ (pin st 'labels ())
       _ (lig-prep st h)
       (? (0 < h 'nl)
          (: _ (left st) _ (out st "LIGTABLE") _ (out-ln st)
             _ (lig-activity st h)
             _ (lig-out st h)
             _ (right st)
             (cycles st h))))
   (check-exten st h)
    (: (go c d) (? (c < h 'ne)
                   (? (3 < d) (go (c + 1) 0)
                      (: k (4 * (h 'exten + c) + d)
                         _ (? ((0 < b st k || d = 3) && none? st h (b st k))
                              (: _ (bad-char st "Extensible recipe involves the" (b st k))
                                 (? (d < 3) (bset st k 0))))
                         (go c (d + 1)))))
       (go 0 0))

   ; --- the characters ---------------------------------------------------------------
   (do-char st h c)
    (: _ (left st) _ (out st "CHARACTER") _ (out-char st c) _ (out-ln st)
       _ (left st) _ (out st "CHARWD")
       _ (? (h 'nw <= widx st h c) (range-error st "Width" c) (out-fix st (4 * (h 'width + widx st h c))))
       _ (right st)
       (dim idx n base what name)
        (? (0 < idx)
           (? (n <= idx) (range-error st what c)
              (: _ (left st) _ (out st name) _ (out-fix st (4 * (base + idx))) (right st))))
       _ (dim (hidx st h c) (h 'nh) (h 'height) "Height" "CHARHT")
       _ (dim (didx st h c) (h 'nd) (h 'depth) "Depth" "CHARDP")
       _ (dim (iidx st h c) (h 'ni) (h 'italic) "Italic correction" "CHARIC")
       tg (tag st h c)
       _ (? (tg = 1)
            (: _ (left st) _ (out st "COMMENT") _ (out-ln st)
               i0 (rem st h c) r (lstep h i0)
               (go i) (: k (out-step st h i)
                         j (? (128 <= b st k) (h 'nl) (i + 1 + b st k))
                         (? (j < h 'nl) (go j)))
               _ (go (? (128 < b st r) (256 * b st (r + 2) + b st (r + 3)) i0))
               (right st))
            (tg = 2)
            (: r (rem st h c)
               (? (none? st h r) (: _ (bad-char st "Character list link to" r) (reset-tag st h c))
                  (: (chase r) (? (r < c && tag st h r = 2) (chase (rem st h r)) r)
                     (? (chase r = c)
                        (: _ (bad st "Cycle in a character list!")
                           _ (msg st ("Character " + octal c + " now ends the list.\n"))
                           (reset-tag st h c))
                        (: _ (left st) _ (out st "NEXTLARGER") _ (out-char st r) (right st))))))
            (tg = 3)
            (? (h 'ne <= rem st h c) (: _ (range-error st "Extensible" c) (reset-tag st h c))
               (: _ (left st) _ (out st "VARCHAR") _ (out-ln st)
                  e (4 * (h 'exten + rem st h c))
                  (piece k) (? (k = 3 || 0 < b st (e + k))
                               (: _ (left st) _ (out st (["TOP" "MID" "BOT" "REP"] k))
                                  _ (out-char st (? (none? st h (b st (e + k))) c (b st (e + k))))
                                  (right st)))
                  _ (map piece [0 1 2 3])
                  (right st))))
       (right st))

   ; --- the font as TeX loads it (tex.web 560-575) --------------------------------------
   ; x*n/d to the scaled point, as tex.web 107 does it; a quotient past 2^15 is an
   ; arithmetic error, and the partial answer stands
   (xn-over-d x n d)
    (: ax (abs x)
       t (ax % 32768 * n)
       u (ax // 32768 * n + t // 32768)
       v (u % d * 32768 + t % 32768)
       r (? (32768 <= u // d) u (32768 * (u // d) + v // d))
       (? (x < 0) (0 - r) r))
   ; s is the size asked for: -1000 the design size, s >= 0 an at size in scaled points,
   ; s < 0 a scale of -s/1000. a file TeX would refuse answers 'badtfm
   (tfm-read s sz)
    (: n #s
       (at k) (? (k < n) (s k) 0)
       (w k) (256 * at k + at (k + 1))
       (neg k) (? (24 <= k) 0 (127 < at k) 1 (neg (k + 2)))
       lf (w 0) lh (w 2) bc0 (w 4) ec0 (w 6) nw (w 8) nh (w 10) nd (w 12) ni (w 14)
       nl (w 16) nk (w 18) ne (w 20) np (w 22)
       (? (neg 0 || bc0 > ec0 + 1 || ec0 > 255
           || lf != 6 + lh + (ec0 - bc0 + 1) + nw + nh + nd + ni + nl + nk + ne + np
           || nw = 0 || nh = 0 || nd = 0 || ni = 0 || lh < 2 || 127 < at 28 || n < 4 * lf)
          'badtfm
          (: bc (? (bc0 > 255) 1 bc0) ec (? (bc0 > 255) 0 ec0)
             z0 ((w 28 * 256 + at 30) * 16 + at 31 // 16)
             zs (? (sz = -1000) z0 (0 <= sz) sz (xn-over-d z0 (0 - sz) 1000))
             cb (24 + 4 * lh) wb (cb + 4 * (ec - bc + 1)) hb (wb + 4 * nw) db (hb + 4 * nh)
             ib (db + 4 * nd) lb (ib + 4 * ni) kb (lb + 4 * nl) eb (kb + 4 * nk) pb (eb + 4 * ne)
             (q k) [(at k) (at (k + 1)) (at (k + 2)) (at (k + 3))]
             ; the multiplier under 2^23, and alpha and beta to make up for it
             ab (: (go z a) (? (8388608 <= z) (go (z // 2) (a + a)) [z (256 // a) (a * z)]) (go zs 16))
             z <ab beta <>ab alpha <>>ab
             (sc k) (: a (at k) sw ((((at (k + 3) * z) // 256 + at (k + 2) * z) // 256 + at (k + 1) * z) // beta)
                       (? (a = 0) sw (a = 255) (sw - alpha) 'bad))
             (table base cnt) (: t {} (go i) (? (i < cnt) (: _ (pin t i (sc (base + 4 * i))) (go (i + 1))) t) (go 0))
             ci (: t {} (go c) (? (c <= ec) (: _ (pin t c (q (cb + 4 * (c - bc)))) (go (c + 1))) t) (go bc))
             (exists c) (bc <= c && c <= ec && 0 < <(ci c))
             ; the char_info checks, a charlist cycle included
             (cycle? c d) (? (d < c) (: e (ci d) (? (<>>(e) % 4 != 2) 0 (cycle? c (<>>>(e))))) (d = c))
             cok (all (c \ (: e (ci c) a <e b <>e cc <>>e d <>>>e tg (cc % 4)
                             !(a >= nw || b // 16 >= nh || b % 16 >= nd || cc // 4 >= ni
                               || (tg = 1 && d >= nl) || (tg = 3 && d >= ne)
                               || (tg = 2 && (d < bc || d > ec || cycle? c d)))))
                      (map (+ bc) ^(ec - bc + 1)))
             dims (map (x \ table (x 0) (x 1)) [[wb nw] [hb nh] [db nd] [ib ni]])
             lig (: t {} (go i) (? (i < nl) (: _ (pin t i (q (lb + 4 * i))) (go (i + 1))) t) (go 0))
             bchar (? (0 < nl && at lb = 255) (at (lb + 1)) 256)
             (lok i) (: e (lig i) a <e b <>e c <>>e d <>>>e
                        (? (a > 128) (256 * c + d < nl)
                           ((b = bchar || exists b)
                            && (? (c < 128) (exists d) (256 * (c - 128) + d < nk))
                            && (a >= 128 || i + a + 1 < nl))))
             last (? (0 < nl) (lig (nl - 1)) [0 0 0 0])
             blabel (? (<last = 255) (256 * <>>last + <>>>last) 32767)
             kern (table kb nk)
             ext (: t {} (go i) (? (i < ne) (: _ (pin t i (q (eb + 4 * i))) (go (i + 1))) t) (go 0))
             eok (all (i \ (: e (ext i) (all (x \ x = 0 || exists x) (take 3 e)) && exists (e 3))) ^ne)
             slant (: v (at pb) sv (? (127 < v) (v - 256) v)
                      (((sv * 256 + at (pb + 1)) * 256 + at (pb + 2)) * 16 + at (pb + 3) // 16))
             par (: t {1 (? (0 < np) slant 0)}
                    (go k) (? (k <= max 7 np) (: _ (pin t k (? (k <= np) (sc (pb + 4 * (k - 1))) 0)) (go (k + 1))) t)
                    (go 2))
             (bad? t) (any (k \ t k = 'bad) (keys t))
             (? (z0 < 65536 || !cok || !(all lok ^nl) || !eok || any bad? (kern . par . dims)
                 || (dims 0) 0 != 0 || (dims 1) 0 != 0 || (dims 2) 0 != 0 || (dims 3) 0 != 0)
                'badtfm
                {'check (q 24) 'dsize z0 'size zs 'bc bc 'ec ec 'ci ci
                 'wd (dims 0) 'ht (dims 1) 'dp (dims 2) 'ic (dims 3)
                 'nl nl 'lig lig 'kern kern 'ext ext 'np (max 7 np) 'param par
                 'bchar bchar 'blabel (? (blabel < nl) blabel ())
                 'fbchar (? (exists bchar) 256 bchar)}))))

   ; --- the sizes, as tftopl vets them: a tablet of sizes and base addresses, or the
   ;     reason it gives up ----------------------------------------------------------
   (tfm-sizes s)
    (: n #s
       (at k) (? (k < n) (s k) 0)
       (w k) (256 * at k + at (k + 1))
       lf (w 0)
       ; the twelve sizes in order, the first with a negative high byte refused
       (neg k) (? (24 <= k) 0 (127 < at k) 1 (neg (k + 2)))
       (? (127 < at 0) "The first byte of the input file exceeds 127!"
          (n < 2) "The input file is only one byte long!"
          (lf = 0) "The file claims to have length zero, but that's impossible!"
          (n < 4 * lf) "The file has fewer bytes than it claims!"
          (neg 2) "One of the subfile sizes is negative!"
          (: lh (w 2) bc (w 4) ec (w 6) nw (w 8) nh (w 10) nd (w 12) ni (w 14)
             nl (w 16) nk (w 18) ne (w 20) np (w 22)
             ; 32510 is TeX Live's lig_size; knuth's tftopl.web says 5000
             (? (lh < 2) ("The header length is only " + show lh + "!")
                (nl > 32510) "The lig/kern program is longer than I can handle!"
                (bc > ec + 1 || ec > 255) ("The character code range " + show bc + ".." + show ec + " is illegal!")
                (nw = 0 || nh = 0 || nd = 0 || ni = 0) "Incomplete subfiles for character dimensions!"
                (ne > 256) ("There are " + show ne + " extensible recipes!")
                (lf != 6 + lh + (ec - bc + 1) + nw + nh + nd + ni + nl + nk + ne + np)
                 "Subfile sizes don't add up to the stated total!"
                (: cb (6 + lh - bc) wb (cb + ec + 1) hb (wb + nw) db (hb + nh) ib (db + nd)
                   lb (ib + ni) kb (lb + nl) eb (kb + nk)
                   {'lf lf 'lh lh 'bc bc 'ec ec 'nw nw 'nh nh 'nd nd 'ni ni 'nl nl 'nk nk 'ne ne
                    'np np 'char cb 'width wb 'height hb 'depth db 'italic ib 'lig lb 'kern kb
                    'exten eb 'param (eb + ne - 1)})))))

   ; the junk is said while reading, before the sizes are vetted
   (tfm-pl s)
    (: h (tfm-sizes s) n #s lf (? (1 < n) (256 * s 0 + s 1) 0)
       junk (? (1 < n && s 0 < 128 && 0 < lf && 4 * lf < n)
               "There's some extra junk at the end of the TFM file,\nbut I'll proceed as if it weren't there.\n" "")
       (? (string? h) ["" (junk + h + "\nSorry, but I can't go on; are you sure this is a TFM?\n")]
          (: st (st-new s)
             _ (msg st junk)
             _ (do-header st h)
             _ (do-params st h)
             _ (check-fixes st h)
             _ (do-ligs st h)
             (? (st 'fatal) [(slurp (st 'o)) (slurp (st 'm))]
                (: _ (check-exten st h)
                   (go c) (? (c <= h 'ec)
                             (: _ (? (0 < widx st h c) (do-char st h c)) (go (c + 1))))
                   _ (go (h 'bc))
                   _ (? !(st 'perfect)
                        (out st "(COMMENT THE TFM FILE WAS BAD, SO THE DATA HAS BEEN CHANGED!)\n"))
                   [(slurp (st 'o)) (slurp (st 'm))]))))))
) ; module tfm
