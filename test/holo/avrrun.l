; an avr interpreter over avr-tab: the device's registers, io and ram one data space, its family's
; instructions and no others. a byte stored at 0xc6 (the 328p's uart) is output; break ends the run,
; as does a jump to itself. a word the family lacks, a fetch past flash and an access past ram scare.
(module 'holo
(: avr-out 0xc6 sreg 0x5f
   (ar-new dev flash)
    (: d (avr-dev dev) end (d 2 + d 3)
       {'fam <d 'flash flash 'size (d 1) 'end end 'mem {} 'pc 0 'n 0 'out () 'sp (end - 1) 'halt 0})
   (ar-rd s a) (? (a = 0x5d) (s 'sp & 255) (a = 0x5e) (s 'sp >> 8) (0 <= a && a < s 'end) (peep (s 'mem) a 0) (scare 'avr-bus a))
   (ar-wr s a v)
    (: b (v & 255)
       (? (a = 0x5d) (pin s 'sp (s 'sp & 0xff00 | b)) (a = 0x5e) (pin s 'sp (s 'sp & 255 | b << 8))
          (a = avr-out) (pin s 'out (b . s 'out))
          (0 <= a && a < s 'end) (pin (s 'mem) a b) (scare 'avr-bus a)))
   (ar-w s a) (ar-rd s a | ar-rd s (a + 1) << 8)
   (ar-ww s a v) (ar-wr s a v, ar-wr s (a + 1) (v >> 8))
   (ar-push s v) (ar-wr s (s 'sp) v, pin s 'sp (s 'sp - 1))
   (ar-pop s) (pin s 'sp (s 'sp + 1), ar-rd s (s 'sp))
   ; the pushed pc, a word address: the low byte first, so the high one is at the lower address
   (ar-pushpc s w) (ar-push s (w & 255), ar-push s (w >> 8))
   (ar-poppc s) (: h (ar-pop s) l (ar-pop s) (h << 8 | l))
   ; flags: c z n v s h t i from bit 0
   (ar-fl s i) (ar-rd s sreg >> i & 1)
   ; l: (bit value) pairs to set, the rest kept; s follows n and v unless l says it
   (ar-set s l)
    (ar-wr s sreg (foldl (\ a p (a & (255 ^ (1 << <p)) | p 1 << <p)) (ar-rd s sreg) l))
   (ar-b v i) (v >> i & 1)
   ; n, s and z of an 8-bit result beside its v
   (ar-nz r v) (ar-b r 7 @ n [[1 (r = 0 ? 1 0)] [2 n] [3 v] [4 (n ^ v)]])
   (ar-add s d r c)
    (: t (d + r + c) x (t & 255) v (ar-b ((d ^ x) & (r ^ x)) 7)
       (ar-set s (ar-nz x v + [[0 (t >> 8)] [5 (((d & 15) + (r & 15) + c) >> 4)]]), x))
   ; keep: sbc, sbci and cpc leave z clear unless it stood
   (ar-sub s d r c keep)
    (: t (d - r - c) x (t & 255) v (ar-b ((d ^ r) & (d ^ x)) 7)
       z (x = 0 && (!keep || ar-fl s 1 = 1) ? 1 0)
       (ar-set s (ar-nz x v + [[0 (t < 0 ? 1 0)] [5 ((d & 15) - (r & 15) - c < 0 ? 1 0)] [1 z]]), x))
   (ar-logic s x) (ar-set s (ar-nz x 0), x)
   (ar-shr s d top)
    (: x (d >> 1 | top << 7) c (d & 1) n (ar-b x 7)
       (ar-set s [[0 c] [1 (x = 0 ? 1 0)] [2 n] [3 (n ^ c)] [4 c]], x))
   (ar-s8 v) (v > 127 ? (v - 256) v)
   (ar-mul s p0 sh)
    (: p (p0 & 0xffff) q (p << sh & 0xffff)
       (ar-ww s 0 q, ar-set s [[0 (p >> 15)] [1 (q = 0 ? 1 0)]]))
   (ar-ptr p) (p @ "X" 26 "X+" 26 "-X" 26 "Y+" 28 "-Y" 28 30)
   ; a pointer's address, stepped as it is spelled
   (ar-ea s p)
    (: b (ar-ptr p) a (ar-w s b)
       (? (elem p '("-X" "-Y" "-Z")) (: n (a - 1 & 0xffff) (ar-ww s b n, n))
          (elem p '("X+" "Y+" "Z+")) (ar-ww s b (a + 1 & 0xffff), a) a))
   ar-cc '((brlo 0 1) (breq 1 1) (brmi 2 1) (brvs 3 1) (brlt 4 1) (brhs 5 1) (brts 6 1) (brie 7 1)
           (brsh 0 0) (brne 1 0) (brpl 2 0) (brvc 3 0) (brge 4 0) (brhc 5 0) (brtc 6 0) (brid 7 0))
   ar-sets '(sec sez sen sev ses seh set sei) ar-clrs '(clc clz cln clv cls clh clt cli)
   (ar-index x l) (: (go l i) (? !(two? l) -1 (<l = x) i (go >l (i + 1))) (go l 0))
   (ar-fetch s pc) (0 <= pc && pc + 2 <= s 'size ? (avr-dec (s 'fam) (s 'flash) pc pc) (scare 'avr-flash pc))
   ; one instruction; answers s
   (ar-step s)
    (: pc (s 'pc) it (ar-fetch s pc) i (it 1) nx (pc + <it)
       _ (<i = 'op ? 0 (scare 'avr-op pc))
       mn (i 1) o (i 2) (v k) (last (o k)) a (two? o ? (v 0) 0) b (two? o && two? >o ? (v 1) 0)
       (rg k) (ar-rd s k) (go p) (pin s 'pc p)
       (to x) (ar-wr s a x)
       (skip c) (c ? (go (nx + <(ar-fetch s nx))) 0)
       cc (ar-index mn (map (\ c <c) ar-cc))
       _ (pin s 'n (s 'n + 1), go nx)
       (,
        (? (0 <= cc) (: c (ar-cc cc) (ar-fl s (c 1) = c 2 ? (go (nx + a)) 0))
           (elem mn ar-sets) (ar-set s [[(ar-index mn ar-sets) 1]])
           (elem mn ar-clrs) (ar-set s [[(ar-index mn ar-clrs) 0]])
           (mn @ ('nop || 'sleep || 'wdr) 0
            'break (pin s 'halt 1)
            'add (to (ar-add s (rg a) (rg b) 0)) 'adc (to (ar-add s (rg a) (rg b) (ar-fl s 0)))
            'lsl (to (ar-add s (rg a) (rg a) 0)) 'rol (to (ar-add s (rg a) (rg a) (ar-fl s 0)))
            'sub (to (ar-sub s (rg a) (rg b) 0 0)) 'subi (to (ar-sub s (rg a) b 0 0))
            'sbc (to (ar-sub s (rg a) (rg b) (ar-fl s 0) 1)) 'sbci (to (ar-sub s (rg a) b (ar-fl s 0) 1))
            'cp (ar-sub s (rg a) (rg b) 0 0) 'cpi (ar-sub s (rg a) b 0 0) 'cpc (ar-sub s (rg a) (rg b) (ar-fl s 0) 1)
            'and (to (ar-logic s (rg a & rg b))) 'tst (ar-logic s (rg a)) 'andi (to (ar-logic s (rg a & b)))
            'or (to (ar-logic s (rg a | rg b))) 'ori (to (ar-logic s (rg a | b)))
            'eor (to (ar-logic s (rg a ^ rg b))) 'clr (to (ar-logic s 0))
            'com (: x (255 - rg a) (to x, ar-logic s x, ar-set s [[0 1]]))
            'neg (: d (rg a) (to (ar-sub s 0 d 0 0)))
            'inc (: x (rg a + 1 & 255) (to x, ar-set s (ar-nz x (x = 128 ? 1 0))))
            'dec (: x (rg a - 1 & 255) (to x, ar-set s (ar-nz x (x = 127 ? 1 0))))
            'lsr (to (ar-shr s (rg a) 0)) 'ror (to (ar-shr s (rg a) (ar-fl s 0))) 'asr (to (ar-shr s (rg a) (ar-b (rg a) 7)))
            'swap (: d (rg a) (to (d << 4 | d >> 4))) 'ldi (to b) 'mov (to (rg b)) 'movw (ar-ww s a (ar-w s b))
            ('adiw || 'sbiw)
             (: up (mn = 'adiw) d (ar-w s a) t (up ? (d + b) (d - b)) x (t & 0xffff) n (ar-b x 15)
                v (up ? (n & (1 - ar-b d 15)) (ar-b d 15 & (1 - n)))
                (ar-ww s a x, ar-set s [[0 (t < 0 || t > 0xffff ? 1 0)] [1 (x = 0 ? 1 0)] [2 n] [3 v] [4 (n ^ v)]]))
            'mul (ar-mul s (rg a * rg b) 0) 'muls (ar-mul s (ar-s8 (rg a) * ar-s8 (rg b)) 0)
            'mulsu (ar-mul s (ar-s8 (rg a) * rg b) 0) 'fmul (ar-mul s (rg a * rg b) 1)
            'fmuls (ar-mul s (ar-s8 (rg a) * ar-s8 (rg b)) 1) 'fmulsu (ar-mul s (ar-s8 (rg a) * rg b) 1)
            ('rjmp || 'rcall) (, (mn = 'rcall ? (ar-pushpc s (nx >> 1)) 0) (go (nx + a)))
            ('jmp || 'call) (, (mn = 'call ? (ar-pushpc s (nx >> 1)) 0) (go a))
            ('ijmp || 'icall) (, (mn = 'icall ? (ar-pushpc s (nx >> 1)) 0) (go (2 * ar-w s 30)))
            'ret (go (2 * ar-poppc s)) 'reti (, (go (2 * ar-poppc s)) (ar-set s [[7 1]]))
            'cpse (skip (rg a = rg b)) 'sbrc (skip (ar-b (rg a) b = 0)) 'sbrs (skip (ar-b (rg a) b = 1))
            'sbic (skip (ar-b (rg (a + 32)) b = 0)) 'sbis (skip (ar-b (rg (a + 32)) b = 1))
            'sbi (ar-wr s (a + 32) (rg (a + 32) | 1 << b)) 'cbi (ar-wr s (a + 32) (rg (a + 32) & (255 ^ (1 << b))))
            'in (to (rg (b + 32))) 'out (ar-wr s (a + 32) (rg b))
            'lds (to (rg b)) 'sts (ar-wr s a (rg b))
            'ldd (to (rg (ar-w s (o 1 1 = 'Y ? 28 30) + b)))
            'std (ar-wr s (ar-w s (o 0 1 = 'Y ? 28 30) + a) (rg b))
            'ld (: e (ar-ea s b) (to (rg e))) 'st (: x (rg b) e (ar-ea s a) (ar-wr s e x))
            'lpm (: d (two? o ? a 0) z (ar-ea s (two? o ? b "Z")) (z < #(s 'flash) ? (ar-wr s d (s 'flash z)) (scare 'avr-lpm z)))
            'push (ar-push s (rg a)) 'pop (to (ar-pop s))
            'bst (ar-set s [[6 (ar-b (rg a) b)]]) 'bld (to (rg a & (255 ^ (1 << b)) | ar-fl s 6 << b))
            (scare 'avr-run mn)))
        (s 'pc = pc ? (pin s 'halt 1) 0) s))
   ; runs to its end or max steps; answers s
   (ar-run s max) (s 'halt = 1 || s 'n >= max ? s (ar-run (ar-step s) max)))
) ; module 'holo
