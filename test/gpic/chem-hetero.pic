.PS
copy "chem.pic"
	textht = 0.16; textwid = .1; cwid = 0.12
	lineht = 0.2; linewid = 0.2
Last: 0,0

#R: ring put N at 1 put O at 2
R: Last: [
	C: 0,0
	V0: (-0.259808,0.15)
	V1: (0,0.3)
	V2: (0.259808,0.15)
	V3: (0.259808,-0.15)
	V4: (8.00947e-09,-0.3)
	V5: (-0.259808,-0.15)
	V6: (-0.259808,0.15)
	V7: (-1.60189e-08,0.3)
	V1: ellipse invis ht 0.16 wid 0.12 at V1
	N:atom("N", 0.12, 0.16, 0.06, 0.16, 0.12, 0.015) at V1
	line from V1 to V2 chop 0.08 chop 0.08
	V2: ellipse invis ht 0.16 wid 0.12 at V2
	O:atom("O", 0.12, 0.16, 0.06, 0.16, 0.12, 0.015) at V2
	line from V2 to V3 chop 0.08 chop 0
	line from V3 to V4 chop 0 chop 0
	line from V4 to V5 chop 0 chop 0
	line from V5 to V6 chop 0 chop 0
	line from V6 to V1 chop 0 chop 0.08
] with .V5.w at Last.e 

#bond 30 from R.N
Last: bond(0.2, 30, from R.N.ne)

#CH3
Last: CH3: atom("CH\s-3\d3\u\s+3", 0.3, 0.16, 0.06, 0.16, 0.12, 0.015) with .L.sw at Last.end
.PE
