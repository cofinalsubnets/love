.PS
copy "chem.pic"
	textht = 0.16; textwid = .1; cwid = 0.12
	lineht = 0.2; linewid = 0.2
Last: 0,0

#R1: ring pointing up aromatic
R1: Last: [
	C: 0,0
	V0: (-0.311769,0.18)
	V1: (0,0.36)
	V2: (0.311769,0.18)
	V3: (0.311769,-0.18)
	V4: (9.61137e-09,-0.36)
	V5: (-0.311769,-0.18)
	V6: (-0.311769,0.18)
	V7: (-1.92227e-08,0.36)
	line from V1 to V2
	line from V2 to V3
	line from V3 to V4
	line from V4 to V5
	line from V5 to V6
	line from V6 to V1
	circle rad 0.18 at 0,0
] with .V5.w at Last.e 

#bond 45 from R1.V2 ; NH2
Last: bond(0.25, 45, from R1.V2.ne)
Last: NH2: atom("NH\s-3\d2\u\s+3", 0.36, 0.192, 0.072, 0.192, 0.144, 0.018) with .L.sw at Last.end

#bond 135 from R1.V3 ; "text here"
Last: bond(0.25, 135, from R1.V3.se)
Last: texthere: atom(""text here"", 0.792, 0.192, 0.072, 0.192, 0.144, 0.018) with .L.nw at Last.end
.PE
