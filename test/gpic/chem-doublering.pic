.PS
copy "chem.pic"
	textht = 0.16; textwid = .1; cwid = 0.12
	lineht = 0.2; linewid = 0.2
Last: 0,0

#ring double 1,2 3,4 5,6
Last: [
	C: 0,0
	V0: (-0.259808,0.15)
	V1: (0,0.3)
	V2: (0.259808,0.15)
	V3: (0.259808,-0.15)
	V4: (8.00947e-09,-0.3)
	V5: (-0.259808,-0.15)
	V6: (-0.259808,0.15)
	V7: (-1.60189e-08,0.3)
	line from V1 to V2
	line from 0.85<C,V1> to 0.85<C,V2>
	line from V2 to V3
	line from V3 to V4
	line from 0.85<C,V3> to 0.85<C,V4>
	line from V4 to V5
	line from V5 to V6
	line from 0.85<C,V5> to 0.85<C,V6>
	line from V6 to V1
] with .V5.w at Last.e 

#bond down
Last: bond(0.2, 180, from Last.V4.s )

#B1: bond ; OH
B1: Last: bond(0.2, 180, from Last.end )
Last: OH: atom("OH", 0.24, 0.16, 0.06, 0.16, 0.12, 0.015) with .C.n at Last.end
.PE
