#bond right from C
Last: bond(0.2, 90, from C.R.e)

#CH3
Last: CH3: atom("CH\s-3\d3\u\s+3", 0.3, 0.16, 0.06, 0.16, 0.12, 0.015) with .L.w at Last.end
