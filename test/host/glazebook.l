; run by glazehot.l's children, once per mode: every line must read as the interpreter's
(: (zork a b) (a 0 * b 0)
   (f a b) (zork (a 0) b - a 1))
(: (late a) (later (a + 0) + 1))
(: (cnt n a) (n = 0 ? a (cnt (n - 1) (a + zork [n 0] [1 0]))))
(: (later a) 7)
(module (gb1 dot) (: (dot a b) (a 0 * b 0 + a 1 * b 1)))
(module (gb2 g) (borrow 'gb1) (: (g a b) (dot (a 0) b - a 1)))
(borrow 'gb2)
(: (argh h a) (h zork a))
(: (eqf a b) (a = b ? (late 1) 2))
(: A [[2 3] 4] B [5 6])
(: (pass _) [(f A B) (late 1) (cnt 5 0) (g A B) (argh (k \ x \ k x x) [3 1]) (eqf 1 1) (eqf "a" "a")])
(: (spin i) (i = 0 ? 0 (pass (), spin (i - 1))))
(: p0 (pass ()))
(: (zork a b) 99)
(: (later a) 8)
(: (dot a b) 77)
(spin 1200)
(puts "book \(show p0) \(show (pass ()))\n")
; a word the lanes read by name, rebound
(: (+ a b) 1000)
(: (tally x) 7)
(: (cap x) 'mine)
(: (sum a b) (a + b)
   (walk n s) (n = 0 ? s (walk (n - 1) (s + 1)))
   (head a) (two? a ? [(cap a) (tally a)] 0)
   (hwalk n a) (n = 0 ? (<a . cap a . tally a . ()) (hwalk (n - 1) a)))
(: (spin2 i) (i = 0 ? 0 (sum 1 2, walk 2 0, head [1 2], hwalk 2 [1 2], spin2 (i - 1))))
(spin2 1200)
(puts "word \(show [(sum 1 2) (walk 2 0) (head [1 2]) (hwalk 2 [1 2])])\n")
