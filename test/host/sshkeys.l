; --- test/host/sshkeys.l: kore's ssh-keygen, ssh-copy-id and ssh-keyscan ------------------------
; keys made bare and locked, read back by the module and by -y and -l, a passphrase changed,
; known_hosts searched and pruned. where openssh's ssh-keygen is installed, each reads the
; other's keys, bare and locked. then a server of our own on a loopback port: its key scanned,
; plain and hashed, and a key copied onto the authorized_keys it reads -- once, then skipped --
; and logged in with. copy-id's target is -t's file here, never this user's own ~/.ssh.
;   cat test/00-init.l test/host/sshkeys.l | out/love
(borrow 'posix)
(borrow 'tls)
(borrow 'ssh)
(borrow 'bytes)
(: love <cmdline
   dir ((cwd 0) + "/out/.sshkeyst")
   _ (hark ["rm" "-rf" dir]) _ (mkdir dir 448)
   (sq s) ("'" + join "'\\''" (split s 39) + "'")
   ; a command, stderr with stdout -> (status . output)
   (sh argv) (hark ["sh" "-c" (join " " (map sq argv) + " 2>&1")])
   (k as) (sh (love . "kore" . as))
   (got p) (: q (open p "r") (? (hot? q) (: s (slurp q) _ (close q) s) ()))
   (put p s) (: q (open p "w") _ (say q s) (close q))
   (has? t s) (0 <= (fsub t s 0))
   (fpr pub) ("SHA256:" + b64e (sha (sstr "ssh-ed25519" + sstr pub)) 0)
   (mode p) (stat p 2 & 511)

   ; made bare and locked, 0600 beside a .pub, and read back by the module
   g1 (k ["ssh-keygen" "-q" "-N" "" "-C" "bare@test" "-f" (dir + "/a")])
   g2 (k ["ssh-keygen" "-q" "-N" "pass word" "-a" "4" "-C" "locked@test" "-f" (dir + "/b")])
   ka (ssh-key (dir + "/a") (\ _ ()))
   kb (ssh-key (dir + "/b") (\ _ "pass word"))
   kx (ssh-key (dir + "/b") (\ _ "wrong"))
   _ (test (<g1 = 0) (>g1 = "") (<g2 = 0) (two? ka) (two? kb) (ed-pub <ka = ka 1) (ed-pub <kb = kb 1)
           (string? kx) (has? kx "incorrect passphrase")
           ((got (dir + "/a.pub")) = ssh-publine (ka 1) "bare@test")
           ((got (dir + "/b.pub")) = ssh-publine (kb 1) "locked@test")
           (mode (dir + "/a") = 384) (mode (dir + "/b") = 384))
   ; the talking kind
   g3 (k ["ssh-keygen" "-N" "" "-C" "loud" "-f" (dir + "/c")])
   _ (test (<g3 = 0) (has? >g3 "Your identification has been saved in") (has? >g3 (dir + "/c.pub"))
           (has? >g3 "The key fingerprint is:") (has? >g3 " loud\n")
           (two? (ssh-key (dir + "/c") (\ _ ()))))

   ; -y, -l: the public line, and fingerprints of a key, a .pub and each line of a file
   y1 (k ["ssh-keygen" "-y" "-f" (dir + "/a")])
   y2 (k ["ssh-keygen" "-y" "-P" "pass word" "-f" (dir + "/b")])
   y3 (k ["ssh-keygen" "-y" "-P" "nope" "-f" (dir + "/b")])
   l1 (k ["ssh-keygen" "-l" "-f" (dir + "/a")])
   l2 (k ["ssh-keygen" "-lf" (dir + "/b.pub")])
   _ (put (dir + "/ak") ("# keys\nfrom=\"10.0.0.1\" " + ssh-publine (ka 1) "opt" + ssh-publine (kb 1) ""))
   l3 (k ["ssh-keygen" "-l" "-f" (dir + "/ak")])
   _ (test (<y1 = 0) (>y1 = got (dir + "/a.pub")) (<y2 = 0) (>y2 = got (dir + "/b.pub"))
           (<y3 = 255) (has? >y3 "incorrect passphrase")
           (>l1 = "256 " + fpr (ka 1) + " bare@test (ED25519)\n")
           (>l2 = "256 " + fpr (kb 1) + " locked@test (ED25519)\n")
           (>l3 = "256 " + fpr (ka 1) + " opt (ED25519)\n256 " + fpr (kb 1) + " no comment (ED25519)\n"))

   ; -p: another passphrase, then none, the key and its comment the same
   p1 (k ["ssh-keygen" "-p" "-P" "pass word" "-N" "other" "-a" "4" "-f" (dir + "/b")])
   kb1 (ssh-key (dir + "/b") (\ _ "other"))
   kb0 (ssh-key (dir + "/b") (\ _ "pass word"))
   p2 (k ["ssh-keygen" "-p" "-P" "other" "-N" "" "-f" (dir + "/b")])
   y4 (k ["ssh-keygen" "-y" "-f" (dir + "/b")])
   _ (test (<p1 = 0) (kb1 = kb) (string? kb0) (<p2 = 0) ((ssh-key (dir + "/b") (\ _ ())) = kb)
           (>y4 = ssh-publine (kb 1) "locked@test") (mode (dir + "/b") = 384))

   ; known_hosts: -F prints a host's lines, -R removes them, names in any case, and keeps .old
   ea (b64e (sstr "ssh-ed25519" + sstr (ka 1)) 1) eb (b64e (sstr "ssh-ed25519" + sstr (kb 1)) 1)
   kh (dir + "/known_hosts")
   khtext ("h1 ssh-ed25519 " + ea + "\n[h2]:2222 ssh-ed25519 " + ea + "\n# h1\nh3,H1 ssh-ed25519 " + eb + "\n")
   _ (put kh khtext) _ (chmod kh 416)
   f1 (k ["ssh-keygen" "-F" "h1" "-f" kh])
   f2 (k ["ssh-keygen" "-F" "nope" "-f" kh])
   f3 (k ["ssh-keygen" "-F" "[h2]:2222" "-f" kh])
   _ (test (<f1 = 0) (>f1 = "# Host h1 found: line 1 \nh1 ssh-ed25519 " + ea + "\n# Host h1 found: line 4 \nh3,H1 ssh-ed25519 " + eb + "\n")
           (<f2 = 1) (>f2 = "") (<f3 = 0) (has? >f3 "line 2 \n[h2]:2222"))
   r1 (k ["ssh-keygen" "-R" "H1" "-f" kh])
   r2 (k ["ssh-keygen" "-R" "nope" "-f" kh])
   _ (test (<r1 = 0) (>r1 = "# Host H1 found: line 1\n# Host H1 found: line 4\n" + kh + " updated.\nOriginal contents retained as " + kh + ".old\n")
           ((got kh) = "[h2]:2222 ssh-ed25519 " + ea + "\n# h1\n") ((got (kh + ".old")) = khtext) (mode kh = 416)
           (<r2 = 0) (has? >r2 "Host nope not found in"))

   ; openssh's ssh-keygen, where there is one: each reads the other's, bare and locked
   o (: q (open "/usr/bin/ssh-keygen" "r") (? (hot? q) (: _ (close q) 1) 0))
   _ (? o (: _ (k ["ssh-keygen" "-q" "-N" "x y" "-a" "4" "-C" "ours" "-f" (dir + "/d")])
             oy1 (sh ["ssh-keygen" "-y" "-f" (dir + "/a")])
             oy2 (sh ["ssh-keygen" "-y" "-P" "x y" "-f" (dir + "/d")])
             ol1 (sh ["ssh-keygen" "-l" "-f" (dir + "/a")])
             t1 (sh ["ssh-keygen" "-q" "-t" "ed25519" "-N" "" "-C" "their@bare" "-f" (dir + "/t1")])
             t2 (sh ["ssh-keygen" "-q" "-t" "ed25519" "-N" "s3cret" "-a" "4" "-C" "their@locked" "-f" (dir + "/t2")])
             wy1 (k ["ssh-keygen" "-y" "-f" (dir + "/t1")])
             wy2 (k ["ssh-keygen" "-y" "-P" "s3cret" "-f" (dir + "/t2")])
             wl1 (k ["ssh-keygen" "-l" "-f" (dir + "/t1")])
             tl1 (sh ["ssh-keygen" "-l" "-f" (dir + "/t1")])
             wl2 (k ["ssh-keygen" "-l" "-f" (dir + "/t2")])
             tl2 (sh ["ssh-keygen" "-l" "-f" (dir + "/t2")])
             wp (k ["ssh-keygen" "-p" "-P" "s3cret" "-N" "n3w" "-a" "4" "-f" (dir + "/t2")])
             oy3 (sh ["ssh-keygen" "-y" "-P" "n3w" "-f" (dir + "/t2")])
             _ (put kh khtext)
             of (sh ["ssh-keygen" "-F" "h1" "-f" kh]) wf (k ["ssh-keygen" "-F" "h1" "-f" kh])
             olk (sh ["ssh-keygen" "-l" "-f" kh]) wlk (k ["ssh-keygen" "-l" "-f" kh])
             (test (>oy1 = got (dir + "/a.pub")) (>oy2 = got (dir + "/d.pub")) (>ol1 = >l1)
                   (<t1 = 0) (<t2 = 0) (>wy1 = got (dir + "/t1.pub")) (>wy2 = got (dir + "/t2.pub"))
                   (>wl1 = >tl1) (>wl2 = >tl2) (<wp = 0) (>oy3 = got (dir + "/t2.pub"))
                   (>wf = >of) (<wf = <of) (>wlk = >olk)))
        0)

   ; a server: its key scanned, and a key copied onto the authorized_keys it reads
   me (ssh-me 0)
   user (me 0)
   port (test-free 0)
   _ (map (n \ k ["ssh-keygen" "-q" "-N" "" "-C" n "-f" (dir + "/" + n)]) ["host" "id" "new"])
   hk (ssh-key (dir + "/host") (\ _ ()))
   ak (dir + "/authorized_keys")
   _ (put ak (got (dir + "/id.pub"))) _ (chmod ak 384)
   srv (tether [love "kore" "sshd" "-p" (show port) "-h" (dir + "/host") "-o" ("AuthorizedKeysFile=" + ak)])
   _ (test-up port)
   name ("[127.0.0.1]:" + show port)
   line (name + " ssh-ed25519 " + b64e (sstr "ssh-ed25519" + sstr (hk 1)) 1 + "\n")
   s1 (k ["ssh-keyscan" "-q" "-p" (show port) "127.0.0.1"])
   s2 (k ["ssh-keyscan" "-p" (show port) "-t" "rsa,ed25519" "127.0.0.1"])
   s3 (k ["ssh-keyscan" "-p" (show (test-free 0)) "127.0.0.1"])
   s4 (sh ["sh" "-c" (sq love + " kore ssh-keyscan -q -H -p " + show port + " 127.0.0.1 > " + sq (dir + "/hashed"))])
   s5 (k ["ssh-keygen" "-F" name "-f" (dir + "/hashed")])
   _ (test (<s1 = 0) (>s1 = line) (<s2 = 0) (has? >s2 "skipping rsa") (has? >s2 ("# 127.0.0.1:" + show port + " SSH-2.0-love_sshd"))
           (has? >s2 line) (<s3 = 1) (<s4 = 0) ((got (dir + "/hashed")) 0 = 124) (<s5 = 0) (has? >s5 (b64e (sstr "ssh-ed25519" + sstr (hk 1)) 1)))
   os (: q (open "/usr/bin/ssh-keyscan" "r") (? (hot? q) (: _ (close q) 1) 0))
   _ (? os (sh ["ssh-keyscan" "-q" "-p" (show port) "-t" "ed25519" "127.0.0.1"] @ r (test (>r = >s1))) 0)

   ; copy-id: logged in with id, new goes onto the server's file once: -n says, -f is not needed
   (cid as) (k ("ssh-copy-id" . "-p" . show port . "-o" . "StrictHostKeyChecking=no"
                . "-o" . ("IdentityFile=" + dir + "/id") . as))
   far (user + "@127.0.0.1")
   two0 (got (dir + "/id.pub") + got (dir + "/new.pub"))
   c1 (cid ["-n" "-i" (dir + "/new") "-t" ak far])
   ak1 (got ak)
   c2 (cid ["-i" (dir + "/new.pub") "-t" ak far])
   c3 (cid ["-i" (dir + "/new") "-t" ak far])
   _ (test (<c1 = 0) (has? >c1 "would add") (ak1 = got (dir + "/id.pub"))
           (<c2 = 0) (has? >c2 "added") ((got ak) = two0) (mode ak = 384)
           (<c3 = 0) (has? >c3 "already on") ((got ak) = two0))
   ; a target in a directory not there yet, made 700; a file without its last newline mended
   c4 (cid ["-i" (dir + "/new") "-t" (dir + "/far/sub/keys") far])
   _ (put (dir + "/nonl") "# no newline")
   c5 (cid ["-i" (dir + "/new") "-t" (dir + "/nonl") far])
   _ (test (<c4 = 0) ((got (dir + "/far/sub/keys")) = got (dir + "/new.pub")) (mode (dir + "/far/sub") = 448)
           (mode (dir + "/far/sub/keys") = 384) (<c5 = 0) ((got (dir + "/nonl")) = "# no newline\n" + got (dir + "/new.pub")))
   ; and the copied key logs in
   (waitfor pid) (: s (gather pid) (? (two? s) s (nom? s) s (: _ (rest 2) (waitfor pid))))
   lg (: r (tether [love "kore" "ssh" "-p" (show port) "-i" (dir + "/new") "-o" "StrictHostKeyChecking=no" "-T" far "echo in-$((6*7))"])
         t (slurp >r) [t <(waitfor <r)])
   _ (test (has? <lg "in-42") (lg 1 = 0))
   _ (still <srv 15)
   _ (slurp >srv)
   _ (waitfor <srv)

   ; each answers --help and --version through kore's door
   (test (all (t \ (: h (k [t "--help"]) v (k [t "--version"])
                      (<h = 0 && has? >h ("usage: " + t) && <v = 0 && has? >v (t + " / love"))))
              ["ssh-keygen" "ssh-copy-id" "ssh-keyscan"])))

(test_fin (), puts "sshkeys: ok", putc 10, 0)
