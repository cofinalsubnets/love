       (all (s \ two? s && #(s 0) > 1000 && amax (s 0) <= 1.0 && amin (s 0) >= -1.0) snd) (atom? (corridor-sound "none"))))
; the walk: w a s d step and sidestep, two ways at once no faster than one
(: L (lv "(room [-5 0 -5] [5 3 15]) (start [0 0 0] 0 0)")
   (st _) (corridor-new 40 24 L "src/apps/lore/levels/")
