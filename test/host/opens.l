; test/host/opens.l -- what the phone's app opens (src/apps/opens.l), in a nest of its own
;   cat test/00-init.l test/host/opens.l | out/love
(borrow '(posix opens console))
(: nest (cwd 0 + "/out/.opens-nest-" + show (getpid 0))
   old (getenv "LOVE_NEST")
   _ (setenv "LOVE_NEST" nest)
   a (opens-get 0)
   b (opens-set ["lush" "--login"])
   c (opens-get 0)
   d [(opens-ok? ["lush"]) (opens-ok? ["play" "court"]) (opens-ok? ["nonesuch"]) (opens-ok? ()) (opens-ok? ["a\nb"])]
   e (opens-word "play court")
   f (opens-get 0)
   g (opens-word "nonesuch thing")
   h (opens-get 0)
   i (opens-word "")
   j (opens-get 0)
   k (con-eval (_ \ ()) {} "opens \"lush\"")
   l (opens-get 0)
   _ (unlink (opens-file 0)) _ (hark ["rm" "-rf" nest])
   _ (setenv "LOVE_NEST" (string? old ? old ""))
 (test (a = ()) (b = 0) (c = ["lush" "--login"]) (d = [1 1 0 0 0])
       (e = "play court") (f = ["play" "court"])
       (g = "nonesuch is no verb here") (h = f) (i = "the app's own") (j = ()) (k = "lush") (l = ["lush"])))
(test_fin (), puts "opens: ok -- a word kept, a wrong one refused, and the app's own again\n")
