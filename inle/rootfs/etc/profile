# /etc/profile -- what a login shell does on this machine before it says anything.
# lush sources this for `sh --login` (apps/lush.l's sh-profiles), ahead of $HOME/.profile.
# inle/rootfs/ is the machine's own files, laid at the root of every inle boot; nothing
# reads it on a host.
#
# the page boots `sh --login`, so this is the first thing the machine says; a link
# with ?boot= on it names another boot line, which is what a game needs to open on.
cat <<'EOF'
welcome to inle, the love operating system.
this is lush, the love command shell.
the system source code is mounted under /proc/src.
various unix commands such as `vi` are available.
- type `love` to get a love repl.
- type `tower` or `grass` to play a game.
- type `doom` to build DOOM with `love cc` and play.
EOF
