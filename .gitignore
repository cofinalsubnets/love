# the engineering narratives and the design record: local, never tracked, never shipped
notes
vgcore.*
.gdb_history
.claude/
/b/
# downloaded, never built: OVMF, package sources. outside b/ so `make clean`
# leaves it -- `make distclean` is what takes it.
/dl/
# t/proof/rocq/coqc build artifacts (t/proof/rocq/spec.v is checked by `make test_proof`).
# t/proof/rocq/gen.v is GENERATED and TEST-ONLY: test_gen lays it from t/spec.l and checks it in
# the same recipe, so a copy in the tree proves nothing the run does not. t/proof/rocq/uugen.v and
# t/proof/lean/uugen.lean are still checked in -- they regen + re-check in seconds and the diff is
# the drift signal. Only the compiled outputs below are ignored.
t/proof/rocq/gen.v
# (Benches are the exception -- regenerated manually, too slow for per-commit.)
t/proof/lean/*.olean
*.vo
*.vok
*.vos
*.glob
t/proof/rocq/.*.aux
.*.cache
# t/proof/rocq/extract.v EXTRACTS this (test_extract); oracle_drive.ml is the source driver
t/proof/rocq/normalizer.ml
t/proof/rocq/normalizer.mli
t/proof/rocq/oracle_drive
*.cmi
*.cmx
*.cmo
t/proof/rocq/*.o


# python bytecode caches (bench ports) -- build artifacts, never tracked
__pycache__/
*.pyc
*.core


# `love seed` extracts its own source into the CWD and leaves the tree behind when the
# fixpoint fails -- untracked, and one `git add -A` from riding into the next release.
/love-*/

# the engineering narratives: read through and purged locally, never shipped

# the two generated proof terms: test_uugen and test_uulean write them from the uu
# corpus on EVERY run, so a committed copy is 810 KB nothing ever reads
t/proof/rocq/uugen.v
t/proof/lean/uugen.lean
