; tools/mkvs16.l -- the characters VS16 gives an emoji style, off the unicode data, as quay's
; C table (love/quay/cpvs16.h).
;   love tools/mkvs16.l UCD-DIR > love/quay/cpvs16.h
; UCD-DIR holds emoji/emoji-variation-sequences.txt, as https://www.unicode.org/Public/VERSION/ucd/
; serves it. every base with an "emoji style" line, ascending; quay widens one only where its
; own width is 1, so the ones already wide ride along harmlessly.
(borrow 'posix)
(: (rd p) (uread p @ [1 s] (s + "") (die ("cannot read " + p)))
   (die m) (udie 1 ("mkvs16: " + m))
   (hex s) (foldl (a \ c \ a * 16 + hexv c) 0 (chars s))
   (sub? h n) (: (go i) (? ((i + #n) <= #h) (? (n = snip h i (i + #n)) 1 (go (i + 1))) 0) (go 0))
   ; a data line's sequence field as its code points
   (seq ln) (words <(split ";" <(split "#" ln)))
   dir (two? >argv ? <>argv (die "usage: love tools/mkvs16.l UCD-DIR"))
   cps (sort (map (s \ hex <s)
                  (filter (s \ two? s && two? >s && <>s = "FE0F")
                          (map seq (filter (ln \ #ln && !((ln 0) = 35) && (sub? ln "emoji style"))
                                           (lines (rd (dir + "/emoji/emoji-variation-sequences.txt"))))))))
   ; a line of entries at a time, ninety-odd columns wide
   (lay l ln) (? (atom? l) (puts (ln + " };\n"))
                 (: s (show <l + (two? >l ? "," ""))
                    (#ln + #s > 92 ? (puts (ln + "\n"), lay l "  ")
                       (lay >l (ln + " " + s)))))
   (: _ (puts "// cpvs16.h -- the characters VS16 gives an emoji style. generated by tools/mkvs16.l off\n")
      _ (puts "//   unicode's emoji-variation-sequences.txt, do not edit\n//\n")
      (lay cps ("static uint32_t const cpvs16[" + show #cps + "] = {"))))
